{
  "name": "appgestion",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "backend"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @appgestion/web",
    "dev:mobile": "npm run dev --workspace @appgestion/mobile",
    "dev:backend": "npm run dev --workspace @appgestion/backend",
    "build": "npm run build --workspaces --if-present"
  }
}
