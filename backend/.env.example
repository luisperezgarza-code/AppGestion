PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=appgestion_db
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173

# Configure SMTP to send password-reset emails; otherwise a development
# reset link is written to the backend console. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
